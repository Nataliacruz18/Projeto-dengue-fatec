"""
Projeto: FATEC Cidadã - Pipeline de Tratamento de Dados de Focos de Dengue
Descrição: Script de extração, limpeza e unificação dos registros de campo (Ourinhos).
"""

import pandas as pd

print("Iniciando o pipeline de tratamento de dados da dengue...")

# 1. Carregamento dos dados brutos mensais (março a junho)
meses = [3, 4, 5, 6]
lista_dfs = []

for m in meses:
    nome_arquivo = f'dados_dengue_mes{m}.csv'
    try:
        df_mes = pd.read_csv(nome_arquivo)
        lista_dfs.append(df_mes)
        print(f"-> Arquivo {nome_arquivo} carregado com sucesso.")
    except FileNotFoundError:
        print(f"-> Aviso: Arquivo {nome_arquivo} não encontrado nesta pasta.")

if lista_dfs:
    # 2. Concatenação de todas as bases mensais em uma única estrutura
    df_consolidado = pd.concat(lista_dfs, ignore_index=True)
    
    # 3. Tratamento básico de dados e limpeza de consistência
    # Preenchendo valores ausentes em campos numéricos chave com zero para transparência
    colunas_numericas = ['qtd', 'focos eliminados', 'código']
    for col in colunas_numericas:
        if col in df_consolidado.columns:
            df_consolidado[col] = df_consolidado[col].fillna(0)

    # 4. Exportação do resultado final tratado
    arquivo_saida = 'dados_dengue_tratados_finais.csv'
    df_consolidado.to_csv(arquivo_saida, index=False)
    print(f"\nSucesso! Base tratada gerada e salva como: {arquivo_saida}")
else:
    print("Nenhum arquivo de dados mensais foi localizado para processamento.")
